# Env Portainer stack **cloudity-dev** (TAG=dev) — ne pas committer de secrets
# Copier depuis stack.env puis adapter :

TAG=dev
REGISTRY_OWNER=paveldelhomme
NPM_NETWORK=shared-network-copy

# Hôtes distincts de la prod (DNS + NPM à créer)
CLOUDITY_PUBLIC_HOST=cloudity-dev.delhomme.ovh
CLOUDITY_PUBLIC_API_HOST=api-dev.cloudity.delhomme.ovh
CLOUDITY_PUBLIC_PROTO=https
CLOUDITY_PUBLIC_OMIT_PORTS=true
VITE_API_URL=https://api-dev.cloudity.delhomme.ovh
CORS_ORIGINS=https://cloudity-dev.delhomme.ovh,https://admin-dev.cloudity.delhomme.ovh
WEBAUTHN_RP_ID=cloudity-dev.delhomme.ovh
WEBAUTHN_ORIGINS=https://cloudity-dev.delhomme.ovh,https://admin-dev.cloudity.delhomme.ovh
MAIL_OAUTH_FRONTEND_URL=https://mail-dev.cloudity.delhomme.ovh
GOOGLE_OAUTH_REDIRECT_URI=https://api-dev.cloudity.delhomme.ovh/api/mail/oauth/gmail/callback
CLOUDITY_MOBILE_GATEWAY_URL=https://api-dev.cloudity.delhomme.ovh

# Secrets : générer séparément (NE PAS réutiliser POSTGRES/JWT de la prod)
# POSTGRES_USER=…
# POSTGRES_PASSWORD=…
# POSTGRES_DB=cloudity
# REDIS_PASSWORD=…
# JWT_SECRET=…
