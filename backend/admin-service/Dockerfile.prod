# Cloudity admin-service — image production multi-stage.
# Build (depuis la racine du dépôt) :
#   docker build -f backend/admin-service/Dockerfile.prod \
#     -t ghcr.io/…/cloudity-admin-service:latest .
# Voir docs/operations/DEPLOIEMENT-VPS-PORTAINER-NPM.md.

# === Stage 0 : manifests CVE (go.mod, package-lock, requirements) ==========
FROM alpine:3.20 AS cve-manifests
WORKDIR /work
COPY scripts/cve/stage-scan-manifests.sh /stage.sh
COPY . /repo
RUN chmod +x /stage.sh && /stage.sh /repo /cloudity-repo

# === Stage 1 : build des dépendances Python ================================
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /install

RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc libpq-dev \
 && rm -rf /var/lib/apt/lists/*

COPY backend/admin-service/requirements.txt ./
RUN pip install --prefix=/install -r requirements.txt

# === Stage 2 : runtime slim non-root =======================================
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/usr/local/lib/python3.11/site-packages \
    CVE_SCAN_REPO_ROOT=/cloudity-repo \
    CVE_SCAN_CACHE_HOURS=24

RUN apt-get update \
 && apt-get install -y --no-install-recommends libpq5 ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 1000 cloudity \
 && useradd  --system --uid 1000 --gid cloudity cloudity

COPY --from=builder /install /usr/local
COPY --from=cve-manifests /cloudity-repo /cloudity-repo

WORKDIR /app
COPY backend/admin-service /app/
RUN chown -R cloudity:cloudity /app /cloudity-repo

USER cloudity:cloudity
EXPOSE 8082

ENTRYPOINT ["./start.sh"]
